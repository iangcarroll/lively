{
  "name": "lively-key-broker",
  "version": "1.0.0",
  "description": "Mints short-lived Soniox keys for the Lively app",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply lively-key-broker --local",
    "db:migrate": "wrangler d1 migrations apply lively-key-broker --remote"
  },
  "type": "module",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "~4.1",
    "wrangler": "^4.151.3"
  },
  "private": true
}

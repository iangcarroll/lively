{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lively-key-broker",
  // ian@cautela.us
  "account_id": "1020dc9a8bd7a82cd0801975a100d3ee",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // For node:crypto's X509Certificate, which checks App Store signatures.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Run near D1 and Soniox's API rather than near the caller, so a far-away
  // caller pays one long round trip instead of one per upstream call.
  "placement": { "mode": "smart" },
  // The app uses this rather than *.workers.dev, which is often blocked in
  // mainland China.
  "routes": [{ "pattern": "lively.ian.sh", "custom_domain": true }],
  // Deletes expired rate-limit counters.
  "triggers": { "crons": ["17 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lively-key-broker",
      "database_id": "89f13305-9c44-48d3-ac0c-8c24c805555a",
      "migrations_dir": "migrations"
    }
  ],
  // Sign-in codes. The sender's domain must be onboarded under Email Service
  // › Sending in the dashboard.
  "send_email": [{ "name": "EMAIL" }],
  // Keys live KEY_TTL_SECONDS, so the app's spare key survives a few minutes
  // of broker trouble; the app replaces it a minute before it expires.
  // Every key is charged KEY_CHARGE_SECONDS of listening: about half the
  // ~240 s refresh, since reconnects on flaky networks take extra keys.
  "vars": {
    "KEY_TTL_SECONDS": "300",
    "MAX_SESSION_SECONDS": "7200",
    "KEY_CHARGE_SECONDS": "120",
    "PER_INSTALL_KEYS_PER_MINUTE": "6",
    "PER_INSTALL_MINUTES_PER_DAY": "15",
    // Signed-in accounts get these instead of the per-install limits.
    "PER_USER_KEYS_PER_MINUTE": "10",
    "PER_USER_MINUTES_PER_DAY": "30",
    // Lively Pro: a subscription, or an account with `free_pro`. A fair-use cap.
    "PRO_KEYS_PER_MINUTE": "10",
    "PRO_MINUTES_PER_DAY": "600",
    "PER_IP_KEYS_PER_MINUTE": "30",
    "PER_IP_MINUTES_PER_DAY": "1440",
    "GLOBAL_KEYS_PER_DAY": "100000",
    // Comma-separated hashed install IDs. The D1 `denylist` table works too.
    "DENYLIST": "",
    // Email sign-in.
    "EMAIL_FROM": "login@x.ian.sh",
    "CODE_TTL_SECONDS": "600",
    "CODE_MAX_ATTEMPTS": "5",
    "CODES_PER_EMAIL_PER_HOUR": "5",
    "CODES_PER_EMAIL_PER_DAY": "10",
    "CODES_PER_IP_PER_HOUR": "20",
    "SESSION_DAYS": "365",
    // Lively Pro. Sandbox is TestFlight's environment, where purchases are free.
    "APP_BUNDLE_ID": "sh.ian.lively",
    "PRO_PRODUCT_IDS": "sh.ian.lively.pro.monthly,sh.ian.lively.pro.yearly",
    "APP_STORE_ENVIRONMENTS": "Production,Sandbox"
  }
}
